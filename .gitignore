# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/

# ---------- Jupyter ----------
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---------- 数据集 / 大文件 ----------
# GitHub 单个文件上限 100MB，数据集一律不入库
# 用 data/* 而非 data/，这样目录本身能进 Git（靠 .gitkeep），
# 换电脑克隆后文件夹还在，但里面的数据文件不会被上传
data/*
datasets/*
!data/.gitkeep
!datasets/.gitkeep
*.csv
*.tsv
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle
*.model
*.bin
*.tar.gz
*.zip
*.rar
*.7z

# ---------- 环境变量 / 密钥 ----------
.env
*.key

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
