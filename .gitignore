# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/

# ---------- Jupyter ----------
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---------- 数据集 / 大文件 ----------
# GitHub 单个文件上限 100MB，数据集一律不入库
# 用 data/* 而非 data/，这样目录本身能进 Git（靠 .gitkeep），
# 换电脑克隆后文件夹还在，但里面的数据文件不会被上传
data/*
datasets/*
!data/.gitkeep
!datasets/.gitkeep
*.csv
*.tsv
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle
*.model
*.bin
*.tar.gz
*.zip
*.rar
*.7z

# ==========================================================
# 敏感信息 —— 本仓库为公开仓库，以下内容绝对不能提交
# ==========================================================
.env
.env.*
.env.local

# 私钥与证书
*.key
*.pem
*.p12
*.pfx
id_rsa
id_dsa
id_ecdsa
id_ed25519
*_rsa
*_dsa
*_ecdsa
*_ed25519

# AI / 云服务凭据
.openai/
.anthropic/
.aws/credentials
credentials.json
service-account*.json
secrets.yaml
secrets.yml
*_token.txt
*api_key*
*apikey*
*secret*

# 个人隐私（学号、身份证、手机号等）
*personal*
*private*
*身份证*
*学号*

# 临时文件与日志
tmp/
temp/
*.log
*.swp
*~

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
